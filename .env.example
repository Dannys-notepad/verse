# Verse AI environment variables

# Google Gemini API key for generative requests
GEMINI_API_KEY=your_gemini_api_key_here

# AI provider request timeout in milliseconds (default: 30000)
AI_PROVIDER_TIMEOUT_MS=30000

# Maximum output tokens requested from Gemini (default: 1024)
GEMINI_MAX_OUTPUT_TOKENS=1024

# HTTP client timeout for Axios requests (default: 30000)
AXIOS_TIMEOUT=30000
AXIOS_MAX_RETRY=3


